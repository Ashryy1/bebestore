# ==============================================================================
# BibaStore - Environment Configuration
# Copy this file to .env.local and fill in your Supabase credentials when ready
# ==============================================================================

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication (JWT Secret for user authentication tokens)
JWT_SECRET=bibastore_super_secure_jwt_secret_key_2026

# Web Push Notifications (Optional - VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Local Wallets & Payment (Can also be managed dynamically in settings)
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=01000000000
NEXT_PUBLIC_INSTAPAY_USERNAME=bibastore@instapay
